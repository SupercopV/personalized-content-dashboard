# Environment Variables Template
# Copy this file to .env.local to use real external APIs:
# cp .env.example .env.local

# NewsAPI Key (get one free at https://newsapi.org/)
# Note: Used on server-side Next.js route handlers to protect secrets and avoid browser CORS restrictions
NEWS_API_KEY=your_news_api_key_here

# TMDB API Read Access Token or API Key (get one free at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key_here

# App Base URL (optional, defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
